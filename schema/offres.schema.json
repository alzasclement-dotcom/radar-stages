{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radar Stages - data/offres.json",
  "description": "Documentation du schema. La validation reelle est faite par scripts/valider.py (sans dependance). Les niveaux M2 / Bac+5 / fin d'etudes sont exclus : il n'existe pas de valeur pour eux.",
  "type": "object",
  "required": ["derniere_mise_a_jour", "journal", "offres"],
  "additionalProperties": false,
  "properties": {
    "derniere_mise_a_jour": { "type": ["string", "null"], "description": "Date ISO AAAA-MM-JJ ; sert de reference pour la fraicheur dans le score" },
    "journal": {
      "type": "array",
      "description": "Une entree par passage, les 30 dernieres sont conservees.",
      "items": {
        "type": "object",
        "required": ["date", "ajoutees", "expirees", "exclues_niveau_m2", "moins_de_7_jours", "sources_inaccessibles"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string" },
          "ajoutees": { "type": "integer", "minimum": 0 },
          "expirees": { "type": "integer", "minimum": 0 },
          "exclues_niveau_m2": { "type": "integer", "minimum": 0 },
          "moins_de_7_jours": { "type": "integer", "minimum": 0, "description": "Recalcule par le validateur" },
          "sources_inaccessibles": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "offres": { "type": "array", "items": { "$ref": "#/$defs/offre" } }
  },
  "$defs": {
    "offre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "titre", "entreprise", "famille", "ambitieuse", "ville", "region", "metier", "date_debut", "duree",
        "niveau", "competences", "score", "pourquoi", "vigilance", "angle", "url", "type_source",
        "date_publication", "date_estimee", "premiere_detection", "derniere_verification", "statut", "deja_postule"
      ],
      "properties": {
        "id": { "type": "string", "description": "12 premiers caracteres du sha1 de l'URL normalisee (recalcule)" },
        "titre": { "type": "string", "minLength": 1 },
        "entreprise": { "type": "string", "minLength": 1 },
        "famille": { "enum": ["plateforme_investissement", "fintech", "reseau_bancaire", "cgp", "assurance", "gestion_patrimoniale", "autre"] },
        "ambitieuse": { "type": "boolean", "description": "Maison qui recrute surtout en grandes ecoles ; affichee dans la section Ambitieuses (10 % max)" },
        "ville": { "type": "string", "minLength": 1 },
        "region": { "type": "string" },
        "metier": { "enum": ["sales_ir", "allocation", "patrimoine", "asset_management", "epargne_assurance", "banque_finance"] },
        "date_debut": { "type": ["string", "null"], "description": "AAAA-MM-JJ ou AAAA-MM ; null = a verifier" },
        "duree": { "type": ["integer", "null"], "description": "Duree en mois ; null = a verifier" },
        "niveau": { "enum": ["bac3_4", "bac4_5", "non_precise"] },
        "competences": { "type": "array", "items": { "enum": ["excel_vba_python", "relation_patrimoniale", "assurance_vie", "marches"] } },
        "score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Recalcule par le script, jamais saisi a la main" },
        "pourquoi": { "type": "string" },
        "vigilance": { "type": "string" },
        "angle": { "type": "string" },
        "url": { "type": "string", "pattern": "^https?://" },
        "type_source": { "enum": ["officielle", "agregateur"] },
        "date_publication": { "type": ["string", "null"], "description": "AAAA-MM-JJ ; obligatoire, null seulement si non estimable" },
        "date_estimee": { "type": "boolean", "description": "true si date_publication est estimee (il y a X jours)" },
        "premiere_detection": { "type": "string" },
        "derniere_verification": { "type": "string" },
        "statut": { "enum": ["active", "expiree"] },
        "deja_postule": { "type": "boolean" }
      }
    }
  }
}
